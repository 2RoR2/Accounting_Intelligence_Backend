DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/accounting_intelligence
APP_ENV=development

# Set true only for a local development database to enable the demo account seeder.
ENABLE_DEMO_ACCOUNTS=false
FRONTEND_ORIGINS=http://localhost:3000

# Set true when serving over HTTPS.
COOKIE_SECURE=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ai.adminportal@gmail.com
SMTP_FROM=ai.adminportal@gmail.com

# Use a Gmail app password. Keep this backend-only.
SMTP_PASSWORD=

# Production email transport (preferred for Render/Vercel; transactional HTTPS API)
BREVO_API_KEY=
BREVO_FROM_EMAIL=ai.adminportal@gmail.com
BREVO_FROM_NAME=Accounting Intelligence SAIC

# Legacy provider
RESEND_API_KEY=
EMAIL_FROM=ai.adminportal@gmail.com

# Infrastructure Connections
REDIS_URL=redis://localhost:6379/0
TEST_DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/accounting_test_db
DB_PASSWORD=replace-with-local-db-password
