# Copy to .env and fill in. Placeholder values only; never commit real secrets.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/accounting_db
# Password for the docker compose PostgreSQL service (must match DATABASE_URL above)
DB_PASSWORD=change-me
# Signs sessions and encrypts TOTP secrets: a random string of at least 32 characters
# (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET=
# Browser origins allowed to call the API (the Next.js frontend)
FRONTEND_ORIGINS=http://localhost:3000

# Queue: inline = this API process runs extraction (PostgreSQL is the queue); rq = legacy Redis/RQ workers
QUEUE_BACKEND=inline
# Extraction threads in the API process (1 on a 512 MB host)
INLINE_WORKERS=1
# Run the background loop that recovers expired leases and dispatches waiting jobs
INLINE_SUPERVISOR=true
# Release leases nobody has heartbeated for INLINE_STALE_LEASE_SECONDS (at startup and every cycle)
INLINE_RECOVER_ON_START=true
# Seconds without a heartbeat before a lease is released (workers beat every 30 s), 60-3600
INLINE_STALE_LEASE_SECONDS=90

# Extraction: lite = PDF text layer + local CPU OCR; docling = legacy parser (needs requirements-docling.txt)
EXTRACTION_ENGINE=lite
# Longest image side sent to OCR, 800-4096 (lower uses less memory)
LITE_OCR_MAX_SIDE=1024
# Pages read per document, 1-50
LITE_MAX_PAGES=10
# ONNX Runtime threads for OCR, 1-16
OCR_THREADS=1
# Load the OCR weights at startup instead of on the first upload
OCR_WARM_ON_START=false
# ISO code used only when no currency is printed (flagged DEFAULT_CURRENCY_APPLIED); leave empty to keep it unset
DEFAULT_CURRENCY=

# Hosted text model. off (default) = nothing leaves this server; text = masked OCR text only, never the image
AI_EXTRACTION=off
# Providers tried in order: gemini, qwen, openrouter, ollama (on-premises), custom
AI_PROVIDERS=gemini
# Model id for the first provider (empty = provider default)
AI_MODEL=
# API key for the first provider (or use the provider-specific variable below)
AI_API_KEY=
# Gemini key when AI_PROVIDERS starts with gemini
GEMINI_API_KEY=
# verified = values printed in the source fill the field for review; never = keep them as AI candidates only
AI_PREFILL=verified
# DMY or MDY: how to read 03/04/2026 when day and month are both 12 or less
DATE_ORDER=DMY
# Seconds per model request, 1-120
AI_TIMEOUT_SECONDS=30
# Retries for 429/5xx answers, 0-4
AI_MAX_RETRIES=2
# Simultaneous model requests from this process, 1-8
AI_MAX_CONCURRENCY=2
