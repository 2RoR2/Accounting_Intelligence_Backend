# Copy to .env and fill in. Placeholder values only; never commit real secrets.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/accounting_db
# Password for the docker compose PostgreSQL service (must match DATABASE_URL above)
DB_PASSWORD=change-me
# Signs sessions and encrypts TOTP secrets: a random string of at least 32 characters
# (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET=
# Legacy name reserved for deployment compatibility. The app reads AUTH_SECRET.
JWT_SECRET=
# Browser origins allowed to call the API (the Next.js frontend)
FRONTEND_ORIGINS=http://localhost:3000
# Plain HTTP on a laptop. Render sets true and none for hosted UAT.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Upload security. `off` is suitable for local development; production should
# use `required` with ClamAV available on CLAMAV_SOCKET.
UPLOAD_MALWARE_SCAN=off
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# Queue: inline = this API process runs extraction (PostgreSQL is the queue); rq = legacy Redis/RQ workers
QUEUE_BACKEND=inline
# Extraction threads in the API process (1 on a 512 MB host)
INLINE_WORKERS=1
# Run the background loop that recovers expired leases and dispatches waiting jobs
INLINE_SUPERVISOR=true
# Release leases nobody has heartbeated for INLINE_STALE_LEASE_SECONDS (at startup and every cycle)
INLINE_RECOVER_ON_START=true
# Seconds without a heartbeat before a lease is released (workers beat every 30 s), 60-3600
INLINE_STALE_LEASE_SECONDS=90

# Extraction: lite = PDF text layer + local CPU OCR; docling = legacy parser (needs requirements-docling.txt)
EXTRACTION_ENGINE=lite
# Longest image side sent to OCR, 800-4096 (lower uses less memory)
LITE_OCR_MAX_SIDE=1024
# Pages read per document, 1-50
LITE_MAX_PAGES=10
# ONNX Runtime threads for OCR, 1-16
OCR_THREADS=1
# Load the OCR weights at startup instead of on the first upload
OCR_WARM_ON_START=false
# ISO code used only when no currency is printed (flagged DEFAULT_CURRENCY_APPLIED); leave empty to keep it unset
DEFAULT_CURRENCY=

# Hosted text model. off (default) = nothing leaves this server; text = masked OCR text only, never the image
AI_EXTRACTION=off
# Providers tried in order: gemini, qwen, openrouter, ollama (on-premises), custom
AI_PROVIDERS=gemini
# Model id for the first provider (empty = provider default)
AI_MODEL=
# API key for the first provider (or use the provider-specific variable below)
AI_API_KEY=
# Gemini key when AI_PROVIDERS starts with gemini
GEMINI_API_KEY=
# verified = values printed in the source fill the field for review; never = keep them as AI candidates only
AI_PREFILL=verified
# DMY or MDY: how to read 03/04/2026 when day and month are both 12 or less
DATE_ORDER=DMY
# Seconds per model request, 1-120
AI_TIMEOUT_SECONDS=30
# Retries for 429/5xx answers, 0-4
AI_MAX_RETRIES=2
# Simultaneous model requests from this process, 1-8
AI_MAX_CONCURRENCY=2

# Local development only: enables the demo seeds (manage.py seed-demo-company, create-test-users)
APP_ENV=
AI_INJECTION_GUARD=on
AI_DAILY_LIMIT=500
UPLOAD_RATE_LIMIT=60

# Sign-in codes by email: brevo, smtp or auto. Accountants cannot sign in without one of them.
EMAIL_PROVIDER=
BREVO_API_KEY=
# A sender address verified in Brevo
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Team test accounts for manage.py create-test-users (docs/LOCALHOST.md). Keep them here, never in
# the repository: comma separated email or email:role (accountant, local_admin, super_admin);
# at least one local_admin.
UAT_TEST_EMAILS=
# Optional password for new test users (otherwise the command asks for one)
UAT_TEST_PASSWORD=

# Share links give a read-only page for a ready document.
# MyInvois preparation records are never sent to LHDN.
ENABLE_SHARE_LINKS=false
ENABLE_MYINVOIS_PREP=false

# Database and authentication
DB_POOL_SIZE=0
FRONTEND_ORIGIN=
APP_PUBLIC_URL=
FRONTEND_URL=
ENABLE_DEMO_ACCOUNTS=false
# Keep libpq connection overrides unset for local-only admin commands.
# PGHOST=
# PGHOSTADDR=
# PGSERVICE=

# Python and process limits
# PYTHON_VERSION=
# PYTHON_DOTENV_DISABLED=
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
MALLOC_ARENA_MAX=2

# Inline queue and optional replay filters
QUEUE_DISPATCH_BATCH=50
QUEUE_SUPERVISOR_INTERVAL_SECONDS=5
QUEUE_TENANT_ID=
QUEUE_OWNER_ID=
QUEUE_MIN_UPLOADED_AT=
QUEUE_REPLAY_DOCUMENT_IDS=
# REDIS_URL=redis://127.0.0.1:6379/0
# RQ_WORKER_NAME=
WORKER_WARM_MODELS=false

# Lite extraction and optional legacy OCR settings
RAPIDOCR_MODELS_DIR=
RAPIDOCR_DET_MODEL=PP-OCRv6_det_small.onnx
RAPIDOCR_CLS_MODEL=ch_ppocr_mobile_v2.0_cls_mobile.onnx
RAPIDOCR_REC_MODEL=PP-OCRv6_rec_small.onnx
RAPIDOCR_DET_LIMIT_TYPE=min
RAPIDOCR_DET_LIMIT_SIDE_LEN=736
OCR_LANGUAGE=en
ENABLE_IMAGE_OCR=false
IMAGE_OCR_PYTHON=
IMAGE_OCR_MODELS_DIR=
IMAGE_OCR_MAX_BYTES=20971520
IMAGE_OCR_MAX_PIXELS=10000000
IMAGE_OCR_MAX_DIMENSION=8192
IMAGE_OCR_TIMEOUT_SECONDS=60
ENABLE_EXTRACTION_GRAPH=false
DOCLING_MODELS_DIR=
DOCLING_NATIVE_UTILITY_FAST_PATH=true
DOCLING_TABLE_STRUCTURE=false

# Optional text AI. Per-provider overrides use AI_<PROVIDER>_<SETTING>.
AI_BASE_URL=
AI_EXTRA_BODY=
AI_RESPONSE_FORMAT=json_object
AI_GEMINI_MODEL=
AI_GEMINI_BASE_URL=
AI_GEMINI_API_KEY=
AI_GEMINI_EXTRA_BODY=
AI_QWEN_MODEL=
AI_QWEN_BASE_URL=
AI_QWEN_API_KEY=
AI_QWEN_EXTRA_BODY=
AI_OPENROUTER_MODEL=
AI_OPENROUTER_BASE_URL=
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_EXTRA_BODY=
AI_OLLAMA_MODEL=
AI_OLLAMA_BASE_URL=
AI_OLLAMA_API_KEY=
AI_OLLAMA_EXTRA_BODY=
AI_CUSTOM_MODEL=
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_EXTRA_BODY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# Legacy Qwen recovery and second opinions stay disabled
QWEN_PROVIDER=disabled
QWEN_RECOVERY_MODE=off
ENABLE_QWEN_RECOVERY=false
QWEN_SECOND_OPINION_MODE=off
QWEN_RECOVERY_DEADLINE_SECONDS=20
QWEN_CLOUD_ENABLED=false
QWEN_CLOUD_ALLOW_DOCUMENT_UPLOAD=false
QWEN_CLOUD_BASE_URL=
QWEN_CLOUD_MODEL=
QWEN_CLOUD_API_KEY=
QWEN_CLOUD_TIMEOUT_SECONDS=60
QWEN_CLOUD_MAX_RETRIES=0
QWEN_CLOUD_ENABLE_THINKING=false
QWEN_CLOUD_RESPONSE_FORMAT=json_object
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=120

# Email delivery
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=

# Object storage
DOCUMENT_STORAGE_PATH=storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_TLS_VERIFY=true
S3_CONNECT_TIMEOUT_SECONDS=15
S3_READ_TIMEOUT_SECONDS=60
AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=
# AWS_ENDPOINT_URL_S3=
# AWS_CA_BUNDLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
