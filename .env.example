DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/accounting_intelligence
APP_ENV=development

# Set true only for a local development database to enable the demo account seeder.
ENABLE_DEMO_ACCOUNTS=false
FRONTEND_ORIGINS=http://localhost:3000

# Set true when serving over HTTPS.
COOKIE_SECURE=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ai.adminportal@gmail.com
SMTP_FROM=ai.adminportal@gmail.com

# Use a Gmail app password. Keep this backend-only.
SMTP_PASSWORD=
