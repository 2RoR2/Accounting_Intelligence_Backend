  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "evaluation_output",
      "title": "Artifact Type",
      "type": "string"
    },
    "benchmark_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_revision": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Benchmark Revision",
      "type": "string"
    },
    "ground_truth_manifest_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Ground Truth Manifest Sha256",
      "type": "array"
    },
    "prediction_artifact_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Prediction Artifact Sha256",
      "type": "array"
    },
    "evaluator_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Evaluator Version",
      "type": "string"
    },
    "comparison_policy_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Comparison Policy Version",
      "type": "string"
    },
    "row_matching_policy_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Row Matching Policy Version",
      "type": "string"
    },
    "verification_policy_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Verification Policy Version",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Created At",
      "type": "string"
    },
    "field_outcomes": {
      "items": {
        "$ref": "#/$defs/FieldOutcome"
      },
      "title": "Field Outcomes",
      "type": "array"
    },
    "classifications": {
      "items": {
        "$ref": "#/$defs/ClassificationOutcome"
      },
      "title": "Classifications",
      "type": "array"
    },
    "row_matches": {
      "items": {
        "$ref": "#/$defs/RowMatch"
      },
      "title": "Row Matches",
      "type": "array"
    },
    "breakdowns": {
      "items": {
        "$ref": "#/$defs/Breakdown"
      },
      "title": "Breakdowns",
      "type": "array"
    }
