{
  "$defs": {
    "Breakdown": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset"
        },
        "document_type": {
          "anyOf": [
            {
              "enum": [
                "invoice",
                "bill",
                "receipt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Type"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "REAL",
                "SYNTHETIC"
