    "ClassificationOutcome": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Id",
          "type": "string"
        },
        "expected": {
          "enum": [
            "invoice",
            "bill",
            "receipt"
          ],
          "title": "Expected",
          "type": "string"
        },
        "predicted": {
          "enum": [
            "invoice",
            "bill",
            "receipt",
            "credit_note",
            "debit_note",
            "unknown"
          ],
          "title": "Predicted",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exclusion Reason"
        }
      },
      "required": [
        "sample_id",
        "expected",
        "predicted",
        "eligible",
        "exclusion_reason"
      ],
      "title": "ClassificationOutcome",
      "type": "object"
    },
    "Denominators": {
      "additionalProperties": false,
      "properties": {
        "eligible_present": {
          "minimum": 0,
          "title": "Eligible Present",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "incorrect": {
          "minimum": 0,
          "title": "Incorrect",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "eligible_absent": {
          "minimum": 0,
          "title": "Eligible Absent",
          "type": "integer"
        },
        "correct_absent": {
          "minimum": 0,
          "title": "Correct Absent",
          "type": "integer"
        },
        "false_fills": {
          "minimum": 0,
          "title": "False Fills",
          "type": "integer"
        },
        "excluded": {
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        },
        "evidence_available": {
          "minimum": 0,
          "title": "Evidence Available",
          "type": "integer"
        }
