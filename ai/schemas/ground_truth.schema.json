    "Sample": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Id",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "invoice",
            "bill",
            "receipt"
