    "Source": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dataset",
          "type": "string"
        },
        "dataset_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Revision"
        },
        "original_split": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Split"
        },
        "original_sample_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Original Sample Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "REAL",
            "SYNTHETIC"
          ],
          "title": "Origin",
          "type": "string"
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Languages"
        },
        "country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        },
        "file_format": {
          "enum": [
            "pdf",
            "jpg",
            "png"
          ],
          "title": "File Format",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Count"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        },
        "relative_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relative Path",
          "type": "string"
        },
        "private_object_key": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Private Object Key"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Licence"
        },
        "licence_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Licence Reference"
        },
        "annotation_provenance": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Annotation Provenance",
          "type": "string"
        },
        "related_source_group": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Related Source Group",
          "type": "string"
        },
        "base_document_group_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Base Document Group Id",
          "type": "string"
        },
        "template_group_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Template Group Id"
        },
        "quality_variant": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Variant"
        }
      },
      "required": [
        "dataset",
        "dataset_revision",
        "original_split",
        "original_sample_id",
        "origin",
        "languages",
        "country",
        "file_format",
        "page_count",
        "pages",
        "relative_path",
        "private_object_key",
        "sha256",
        "licence",
        "licence_reference",
        "annotation_provenance",
        "related_source_group",
        "base_document_group_id",
        "template_group_id",
        "quality_variant"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "frozen_ground_truth",
      "title": "Artifact Type",
      "type": "string"
    },
    "field_dictionary_version": {
      "const": "1.0.0",
      "title": "Field Dictionary Version",
      "type": "string"
    },
    "benchmark_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_revision": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Benchmark Revision",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "SCHEMA_TEST_ONLY",
        "BENCHMARK"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "document_type": {
      "enum": [
        "invoice",
        "bill",
        "receipt"
      ],
