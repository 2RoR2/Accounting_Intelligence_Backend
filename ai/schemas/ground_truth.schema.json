{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "PUBLISHED_ANNOTATION",
            "INDEPENDENT_HUMAN",
            "SYNTHETIC_FIXTURE"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_reference": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        },
        "verification_state": {
          "enum": [
            "PUBLISHED_AS_IS",
            "INDEPENDENTLY_VERIFIED",
            "UNVERIFIED",
            "SCHEMA_TEST_ONLY"
          ],
          "title": "Verification State",
          "type": "string"
        },
        "annotator_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Annotator Id"
        },
        "verifier_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verifier Id"
        },
        "verified_at": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified At"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source_kind",
        "source_reference",
        "revision",
        "verification_state",
        "annotator_id",
        "verifier_id",
        "verified_at"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Normalized Value"
        },
        "printed_text": {
          "title": "Printed Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "annotation": {
          "$ref": "#/$defs/Annotation"
        }
      },
      "required": [
        "candidate_id",
        "value",
        "normalized_value",
        "printed_text",
        "evidence",
        "annotation"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "source_reference": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        },
        "printed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Text"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bbox"
        },
        "coordinate_convention": {
          "anyOf": [
            {
              "const": "xyxy_top_left",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coordinate Convention"
        },
        "coordinate_units": {
          "anyOf": [
            {
              "enum": [
                "pixel",
                "pdf_point",
                "normalized"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coordinate Units"
        },
        "page_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Width"
        },
        "page_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Height"
        }
      },
      "required": [
        "page",
        "source_reference",
        "printed_text",
        "bbox",
        "coordinate_convention",
        "coordinate_units",
        "page_width",
        "page_height"
      ],
      "title": "Evidence",
      "type": "object"
    },
