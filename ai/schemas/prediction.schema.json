      "title": "PredictionCell",
      "type": "object"
    },
    "PredictionGroup": {
      "additionalProperties": false,
      "properties": {
        "prediction_group_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Prediction Group Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "tax_breakdown",
            "charge_breakdown",
            "meter_readings",
            "additional_attributes"
          ],
          "title": "Scope",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/PredictionCell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "prediction_group_id",
        "scope",
        "order",
        "cells"
      ],
      "title": "PredictionGroup",
      "type": "object"
    },
    "PredictionRow": {
      "additionalProperties": false,
      "properties": {
        "prediction_row_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Prediction Row Id",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/PredictionCell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "prediction_row_id",
        "order",
        "cells"
      ],
      "title": "PredictionRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "frozen_pre_review_prediction",
      "title": "Artifact Type",
      "type": "string"
    },
    "sample_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Sample Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "extraction_run_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Extraction Run Id",
      "type": "string"
    },
    "captured_at": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Captured At",
      "type": "string"
    },
    "extractor_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Extractor Version",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "predicted_document_type": {
      "enum": [
        "invoice",
        "bill",
        "receipt",
        "credit_note",
        "debit_note",
        "unknown"
      ],
      "title": "Predicted Document Type",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/PredictionCell"
      },
      "title": "Fields",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/PredictionRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "repeated_groups": {
      "items": {
        "$ref": "#/$defs/PredictionGroup"
      },
      "title": "Repeated Groups",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "sample_id",
    "source_sha256",
    "extraction_run_id",
    "captured_at",
    "extractor_version",
    "configuration_sha256",
    "predicted_document_type",
    "fields",
    "rows",
    "repeated_groups"
  ],
  "title": "FrozenPrediction",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cos40005:module2:prediction:1.0.0",
  "$comment": "Structural schema. Release validation MUST also use the Pydantic validator for field/type/scope, label semantics, geometry and file integrity."
}
