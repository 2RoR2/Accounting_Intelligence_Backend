{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "source_reference": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        },
        "printed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Text"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bbox"
        },
        "coordinate_convention": {
          "anyOf": [
            {
              "const": "xyxy_top_left",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coordinate Convention"
        },
        "coordinate_units": {
          "anyOf": [
            {
              "enum": [
                "pixel",
                "pdf_point",
                "normalized"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coordinate Units"
        },
        "page_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Width"
        },
        "page_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Height"
        }
      },
      "required": [
        "page",
        "source_reference",
        "printed_text",
        "bbox",
        "coordinate_convention",
        "coordinate_units",
        "page_width",
        "page_height"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PredictionCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Text"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "method": {
          "enum": [
            "PARSER",
            "OCR",
            "VLM"
          ],
          "title": "Method",
          "type": "string"
        },
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Name"
        },
        "model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        }
      },
      "required": [
        "candidate_id",
        "value",
        "raw_text",
        "evidence",
        "method",
        "model_name",
        "model_version"
      ],
      "title": "PredictionCandidate",
      "type": "object"
    },
