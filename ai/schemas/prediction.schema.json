        "value_type": {
          "enum": [
            "text",
            "decimal",
            "date",
            "time",
            "currency",
            "boolean"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Text"
        },
        "state": {
          "enum": [
            "resolved",
            "missing",
            "ambiguous",
            "conflict",
            "unsupported",
            "unreadable"
          ],
          "title": "State",
          "type": "string"
        },
        "method": {
          "enum": [
            "PARSER",
            "OCR",
            "VLM"
          ],
          "title": "Method",
          "type": "string"
        },
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Name"
        },
        "model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/PredictionCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "field_key",
        "value_type",
        "value",
        "raw_text",
        "state",
