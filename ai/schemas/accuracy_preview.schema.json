        "method",
        "model_version",
        "calibrated_confidence"
      ],
      "title": "FieldComparison",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "NOT_MEASURABLE",
            "EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        },
        "correct": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correct"
        },
        "incorrect": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incorrect"
        },
        "missing_prediction": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Prediction"
        },
        "correct_abstention": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correct Abstention"
        },
        "false_fill": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Fill"
        },
        "not_measurable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Measurable"
        },
        "ambiguous_reference": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambiguous Reference"
        },
        "unreadable_reference": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreadable Reference"
        },
        "accuracy": {
          "$ref": "#/$defs/Ratio"
        },
        "extraction_coverage": {
          "$ref": "#/$defs/Ratio"
        },
        "exact_precision": {
          "$ref": "#/$defs/Ratio"
        },
        "exact_recall": {
          "$ref": "#/$defs/Ratio"
        }
      },
      "required": [
        "status",
        "accuracy",
        "extraction_coverage",
        "exact_precision",
        "exact_recall"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Ratio",
      "type": "object"
    },
    "RowComparison": {
      "additionalProperties": false,
      "properties": {
        "gold_row_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
