    },
    "per_field": {
      "additionalProperties": {
        "$ref": "#/$defs/Metrics"
      },
      "title": "Per Field",
      "type": "object"
    },
    "per_document_type": {
      "additionalProperties": {
        "$ref": "#/$defs/Metrics"
      },
      "title": "Per Document Type",
      "type": "object"
    },
    "per_source_cohort": {
      "additionalProperties": {
        "$ref": "#/$defs/Metrics"
      },
      "title": "Per Source Cohort",
      "type": "object"
    },
    "classification_metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "calibrated_confidence": {
      "title": "Calibrated Confidence",
      "type": "null"
    }
