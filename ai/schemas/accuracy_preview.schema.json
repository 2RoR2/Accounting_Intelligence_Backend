          "title": "Prediction Row Id"
        },
        "outcome": {
          "enum": [
            "MATCHED",
            "MISSING_ROW",
            "EXTRA_ROW",
            "NOT_MEASURABLE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "gold_row_id",
        "prediction_row_id",
        "outcome",
        "reason"
      ],
      "title": "RowComparison",
      "type": "object"
    }
  },
  "additionalProperties": false,
