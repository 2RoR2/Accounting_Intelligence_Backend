  "required": [
    "schema_version",
    "contract_status",
    "dataset_id",
    "benchmark_revision",
    "state",
    "comparison_policy_version",
    "verification_policy_version",
    "row_matching_policy_version",
    "documents",
    "overall",
    "per_field",
    "per_document_type",
    "per_source_cohort",
    "classification_metrics",
    "calibrated_confidence"
  ],
  "title": "AccuracyPreview",
  "type": "object"
