{
  "$defs": {
    "DemoComparison": {
      "additionalProperties": false,
      "properties": {
        "demo_code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Demo Code",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Id",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Id"
        },
        "document_code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Code"
        },
        "raw_extraction_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Extraction Id"
        },
        "extraction_run_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extraction Run Id"
        },
        "frozen_prediction_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frozen Prediction Sha256"
        },
        "ground_truth_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ground Truth Manifest Sha256",
          "type": "string"
        },
        "state": {
          "enum": [
            "NOT_RUN",
            "AWAITING_FROZEN_PREDICTION",
            "EVALUATED"
          ],
          "title": "State",
          "type": "string"
        },
        "origin": {
          "enum": [
            "REAL",
            "SYNTHETIC"
          ],
          "title": "Origin",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "invoice",
            "bill",
            "receipt"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "source_dataset": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Dataset",
          "type": "string"
        },
        "evaluation_split": {
          "enum": [
            "development",
            "calibration",
            "held_out"
          ],
          "title": "Evaluation Split",
          "type": "string"
        },
        "predicted_document_type": {
          "anyOf": [
            {
              "enum": [
                "invoice",
                "bill",
                "receipt",
                "credit_note",
                "debit_note",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predicted Document Type"
        },
        "line_annotation_status": {
          "enum": [
            "NOT_LABELLED",
            "CONFIRMED_EMPTY",
            "LABELLED_ROWS"
          ],
          "title": "Line Annotation Status",
          "type": "string"
        },
        "line_row_coverage": {
          "enum": [
            "UNKNOWN",
            "PARTIAL",
            "COMPLETE"
          ],
          "title": "Line Row Coverage",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldComparison"
          },
          "title": "Fields",
          "type": "array"
        },
        "row_comparisons": {
          "items": {
            "$ref": "#/$defs/RowComparison"
          },
          "title": "Row Comparisons",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "line_item_metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "classification_metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "calibrated_confidence": {
          "title": "Calibrated Confidence",
          "type": "null"
        }
      },
      "required": [
        "demo_code",
        "sample_id",
        "document_id",
        "document_code",
        "raw_extraction_id",
        "extraction_run_id",
        "frozen_prediction_sha256",
        "ground_truth_manifest_sha256",
        "state",
        "origin",
        "document_type",
        "source_dataset",
        "evaluation_split",
        "predicted_document_type",
        "line_annotation_status",
        "line_row_coverage",
        "fields",
        "row_comparisons",
        "metrics",
        "line_item_metrics",
        "classification_metrics",
        "calibrated_confidence"
      ],
      "title": "DemoComparison",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "source_reference": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        },
        "printed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Text"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bbox"
        },
        "coordinate_convention": {
          "anyOf": [
            {
              "const": "xyxy_top_left",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coordinate Convention"
        },
        "coordinate_units": {
          "anyOf": [
            {
              "enum": [
                "pixel",
                "pdf_point",
                "normalized"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coordinate Units"
        },
        "page_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Width"
        },
        "page_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Height"
        }
      },
      "required": [
        "page",
        "source_reference",
        "printed_text",
        "bbox",
        "coordinate_convention",
        "coordinate_units",
        "page_width",
        "page_height"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FieldComparison": {
