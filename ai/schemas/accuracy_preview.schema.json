          "title": "Field Key",
          "type": "string"
        },
        "value_type": {
          "enum": [
            "text",
            "decimal",
            "date",
            "time",
            "currency",
            "boolean"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "reference_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Value"
        },
        "predicted_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predicted Value"
        },
        "gold_row_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gold Row Id"
        },
        "prediction_row_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prediction Row Id"
        },
        "outcome": {
          "enum": [
            "CORRECT",
            "INCORRECT",
            "MISSING_PREDICTION",
            "CORRECT_ABSTENTION",
            "FALSE_FILL",
            "NOT_MEASURABLE",
            "AMBIGUOUS_REFERENCE",
            "UNREADABLE_REFERENCE",
            "NOT_RUN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
